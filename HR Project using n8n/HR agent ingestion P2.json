      "name": "Extract from File"
    },
    {
      "parameters": {
        "jsCode": "// Resume text from previous node\nconst resumeText = $input.first().json.text;\n\n// ---------- Email ----------\nlet sanitized = resumeText.replace(\n  /\\b[A-Z0-9._%+-]+@[A-Z0-9.-]+\\.[A-Z]{2,}\\b/gi,\n  \"[EMAIL]\"\n);\n\n// ---------- Phone ----------\nsanitized = sanitized.replace(\n  /(\\+?\\d{1,3}[\\s\\-]?)?(\\(?\\d{2,5}\\)?[\\s\\-]?)?[\\d\\s\\-]{7,15}\\d/g,\n  \"[PHONE]\"\n);\n\n// ---------- LinkedIn ----------\nsanitized = sanitized.replace(\n  /https?:\\/\\/(www\\.)?linkedin\\.com\\/[^\\s]+/gi,\n  \"[LINKEDIN]\"\n);\n\n// ---------- GitHub ----------\nsanitized = sanitized.replace(\n  /https?:\\/\\/(www\\.)?github\\.com\\/[^\\s]+/gi,\n  \"[GITHUB]\"\n);\n\n// ---------- Portfolio / Personal Website ----------\nsanitized = sanitized.replace(\n  /https?:\\/\\/(?!www\\.linkedin\\.com)(?!github\\.com)[^\\s]+/gi,\n  \"[PORTFOLIO]\"\n);\n\n// ---------- DOB Labels ----------\nsanitized = sanitized.replace(\n  /(date\\s*of\\s*birth|dob)\\s*[:\\-]?\\s*.*$/gim,\n  \"[DOB]\"\n);\n\n// ---------- Common Date Formats ----------\nsanitized = sanitized.replace(\n  /\\b\\d{1,2}[\\/\\-]\\d{1,2}[\\/\\-]\\d{2,4}\\b/g,\n  \"[DATE]\"\n);\n\nsanitized = sanitized.replace(\n  /\\b\\d{1,2}\\s+(Jan|January|Feb|February|Mar|March|Apr|April|May|Jun|June|Jul|July|Aug|August|Sep|September|Oct|October|Nov|November|Dec|December)\\s+\\d{2,4}\\b/gi,\n  \"[DATE]\"\n);\n\n// ---------- Address Labels ----------\nsanitized = sanitized.replace(\n  /(address|current address|permanent address)\\s*:\\s*.*$/gim,\n  \"[ADDRESS]\"\n);\n\n// ---------- Name Labels ----------\nsanitized = sanitized.replace(\n  /^(name)\\s*:\\s*.*$/gim,\n  \"[NAME]\"\n);\n\n// ---------- Optional: Remove first line if it looks like a person's name ----------\n// Assumes first line contains only 2-4 capitalized words.\nconst lines = sanitized.split(\"\\n\");\n\nif (\n  lines.length > 0 &&\n  /^[A-Z][a-z]+(?:\\s+[A-Z][a-z]+){1,3}$/.test(lines[0].trim())\n) {\n  lines[0] = \"[NAME]\";\n}\n\nsanitized = lines.join(\"\\n\");\n\nreturn [\n  {\n    json: {\n      sanitized_resume: sanitized\n    }\n  }\n];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -832,
        160
      ],
      "id": "746427df-321a-48e0-97a8-bf07b2a6451a",
      "name": "Code Sanitized"
    },
    {
      "parameters": {
        "jsCode": "// Resume text from previous node\nconst resume = $json.text || \"\";\n\n// -------------------------\n// Extract Email\n// -------------------------\nconst emailRegex = /\\b[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\\.[A-Za-z]{2,}\\b/g;\nconst emails = [...new Set(resume.match(emailRegex) || [])];\n\n// -------------------------\n// Extract Phone Numbers\n// -------------------------\nconst phoneRegex =\n/(?:\\+?\\d{1,3}[\\s.-]?)?(?:\\(?\\d{2,5}\\)?[\\s.-]?)?\\d{5}[\\s.-]?\\d{5}|\\+?\\d[\\d\\s()-]{8,}\\d/g;\n\nconst phones = [...new Set(\n    (resume.match(phoneRegex) || [])\n        .map(p => p.trim())\n        .filter(p => p.replace(/\\D/g, \"\").length >= 10)\n)];\n\n// -------------------------\n// LinkedIn\n// -------------------------\nconst linkedinRegex =\n/https?:\\/\\/(www\\.)?linkedin\\.com\\/[^\\s]+/gi;\n\nconst linkedin =\n[...new Set(resume.match(linkedinRegex) || [])];\n\n// -------------------------\n// GitHub\n// -------------------------\nconst githubRegex =\n/https?:\\/\\/(www\\.)?github\\.com\\/[^\\s]+/gi;\n\nconst github =\n[...new Set(resume.match(githubRegex) || [])];\n\n// -------------------------\n// Portfolio Websites\n// -------------------------\nconst websiteRegex =\n/https?:\\/\\/(?!.*linkedin)(?!.*github)[^\\s]+/gi;\n\nconst portfolio =\n[...new Set(resume.match(websiteRegex) || [])];\n\n// -------------------------\n// Candidate Name (heuristic)\n// -------------------------\nlet candidateName = \"\";\n\nconst lines = resume\n.split(\"\\n\")\n.map(l => l.trim())\n.filter(Boolean);\n\nfor (const line of lines.slice(0,8)) {\n\n    if (\n        line.length < 40 &&\n        !line.includes(\"@\") &&\n        !/\\d/.test(line) &&\n        /^[A-Za-z.' -]+$/.test(line)\n    ) {\n        candidateName = line;\n        break;\n    }\n}\n\n// -------------------------\n// Address (simple heuristic)\n// -------------------------\nlet address = \"\";\n\nconst addressRegex =\n/(?:Address|Location)\\s*:?\\s*(.+)/i;\n\nconst addr = resume.match(addressRegex);\n\nif(addr){\n    address = addr[1].trim();\n}\n\n// -------------------------\n// Sanitize Resume\n// -------------------------\nlet sanitized = resume;\n\n// Email\nemails.forEach(e=>{\n    sanitized = sanitized.replaceAll(e,\"[EMAIL]\");\n});\n\n// Phone\nphones.forEach(p=>{\n    sanitized = sanitized.replaceAll(p,\"[PHONE]\");\n});\n\n// LinkedIn\nlinkedin.forEach(l=>{\n    sanitized = sanitized.replaceAll(l,\"[LINKEDIN]\");\n});\n\n// GitHub\ngithub.forEach(g=>{\n    sanitized = sanitized.replaceAll(g,\"[GITHUB]\");\n});\n\n// Portfolio\nportfolio.forEach(p=>{\n    sanitized = sanitized.replaceAll(p,\"[PORTFOLIO]\");\n});\n\n// DOB Labels\nsanitized = sanitized.replace(\n  /(date\\s*of\\s*birth|dob)\\s*[:\\-]?\\s*.*$/gim,\n  \"[DOB]\"\n);\n\n// Common Date Formats\nsanitized = sanitized.replace(\n  /\\b\\d{1,2}[\\/\\-]\\d{1,2}[\\/\\-]\\d{2,4}\\b/g,\n  \"[DATE]\"\n);\n\nsanitized = sanitized.replace(\n  /\\b\\d{1,2}\\s+(Jan|January|Feb|February|Mar|March|Apr|April|May|Jun|June|Jul|July|Aug|August|Sep|September|Oct|October|Nov|November|Dec|December)\\s+\\d{2,4}\\b/gi,\n  \"[DATE]\"\n);\n\n// Name Labels\nsanitized = sanitized.replace(\n  /^(name)\\s*:\\s*.*$/gim,\n  \"[NAME]\"\n);\n\n// Address\nif(address){\n    sanitized = sanitized.replace(address,\"[ADDRESS]\");\n}\n\n// Candidate Name\nif(candidateName){\n\n    const escaped =\n    candidateName.replace(/[.*+?^${}()|[\\]\\\\]/g,\"\\\\$&\");\n\n    sanitized =\n    sanitized.replace(new RegExp(escaped,\"g\"),\"[CANDIDATE_NAME]\");\n}\n\n// Remove excessive blank lines\nsanitized = sanitized\n.replace(/\\n{3,}/g,\"\\n\\n\")\n.trim();\n\n// Remove first line if it looks like a person's name\nconst sanitizedLines = sanitized.split(\"\\n\");\n\nif (\n  sanitizedLines.length > 0 &&\n  /^[A-Z][a-z]+(?:\\s+[A-Z][a-z]+){1,3}$/.test(sanitizedLines[0].trim())\n) {\n  sanitizedLines[0] = \"[NAME]\";\n}\n\nsanitized = sanitizedLines.join(\"\\n\");\n\n// -------------------------\n// Output\n// -------------------------\nreturn [{\n    json:{\n        candidate_name: candidateName,\n        emails,\n        phone_numbers: phones,\n        linkedin_urls: linkedin,\n        github_urls: github,\n        portfolio_urls: portfolio,\n        address,\n        sanitized_resume: sanitized\n    }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -832,
